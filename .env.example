# Configure these values in Replit Secrets, Google AI Studio Secrets, or your
# host's server-side secret manager. Legacy BOT_TOKEN and CLIENT_ID aliases are
# still accepted for existing Replit deployments.
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
DISCORD_CLIENT_ID=replace_with_17_to_20_digit_discord_application_id

# Provider credentials.
WAIFU_IM_KEY=replace_with_waifu_im_api_key
NEKOBOT_AUTHORIZATION=replace_with_nekobot_authorization_value

# Optional behavior.
TESTING_GUILD_ID=
COMMAND_REGISTRATION_MODE=global
WAIFU_PICS=false
MEDIA_TIMEOUT_MS=15000
MAX_MEDIA_BYTES=10485760
PREMIUM_USER_IDS=
RATE_LIMIT_STATE_FILE=.runtime/rate-limits.json
INSTANCE_LOCK_FILE=.runtime/bot-instance.lock
INSTANCE_LOCK_STALE_MS=30000
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_SETTLE_MS=2000
SHUTDOWN_HARD_TIMEOUT_MS=12000
LOG_LEVEL=info
LOG_COLORS=auto
LOG_FORMAT=pretty
