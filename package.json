{
  "name": "discord-nsfw-bot",
  "version": "3.0.0",
  "description": "An age-restricted Discord media bot for Cloudflare Workers, built directly on Discord HTTP interactions, the HTTP API v10, and Gateway v10.",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "node scripts/register-commands.mjs",
    "tail": "wrangler tail",
    "check": "node scripts/check.mjs",
    "test": "vitest run",
    "validate": "npm run check && npm test",
    "test:live": "vitest run --config vitest.live.config.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyntaxGhost404/Discord-NSFW-Bot.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
