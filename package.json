  "description": "A modular Discord media bot implemented directly against Discord HTTP API v10 and Gateway v10.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/start-with-logs.mjs",
    "start:direct": "node index.js",
