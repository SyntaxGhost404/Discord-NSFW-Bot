{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "discord-lookup",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-12",
	// The app is static files; only /api/* runs the Worker, which asks the
	// Discord API and returns plain JSON. Unknown paths serve index.html, so
	// a link such as /80351110224678912 opens that lookup.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Lookups per visitor, per Cloudflare location, so nobody can spend the
	// bot's Discord rate limits.
	"ratelimits": [
		{
			"name": "LOOKUPS",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
